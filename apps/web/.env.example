# Copy to .env for local development:
#   cp .env.example .env
#
# API must be running (apps/api) with matching FRONTEND_URL=http://localhost:3000

API_VERSION=1

# Nest API base URL: <globalPrefix>/v<version> — matches setGlobalPrefix('api') + enableVersioning(URI)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v${API_VERSION}

NEXT_PUBLIC_APP_NAME=Healthcare SaaS

NEXT_PUBLIC_WS_URL=http://localhost:3001/ws

# ---------------------------------------------------------------------------
# Cross-site deploy (Vercel frontend + ngrok/hosted API on a different domain).
# Set these in the Vercel project's Environment Variables. Example values:
#   NEXT_PUBLIC_API_URL=https://uncontaminative-comparingly-karly.ngrok-free.dev/api/v1
#   NEXT_PUBLIC_WS_URL=https://uncontaminative-comparingly-karly.ngrok-free.dev/ws
#   NEXT_PUBLIC_CROSS_SITE=true
# NEXT_PUBLIC_CROSS_SITE=true makes auth restore always attempt a token refresh,
# since the API-domain session cookie is not readable from the frontend domain.
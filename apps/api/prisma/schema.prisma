generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  googleId           String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  password           String?
  role               Role     @default(PATIENT)
  hashedRefreshToken String?
  tokenVersion       Int      @default(0)

  organizationId String?
  organization   Organization? @relation("OrganizationMembers", fields: [organizationId], references: [id])

  ownedOrganization Organization? @relation("OrganizationOwner")

  uploadedFiles File[]

  notifications Notification[]

  auditLogs AuditLog[]

  aiRequestLogs AiRequestLog[]

  clinicalNotes ClinicalNote[]

  organizationMemberships OrganizationMember[]
  patientProfile          Patient?
  sentInvitations         Invitation[]         @relation("InvitationInviter")
  appointments            Appointment[]        @relation("AppointmentProvider")
  comments                Comment[]
  assistantConversations  AssistantConversation[]
}

model Organization {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  ownerId     String  @unique
  owner       User    @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members     User[]  @relation("OrganizationMembers")

  // ===============================
  // Stripe connect
  // ===============================

  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)

  payments            Payment[]
  files               File[]
  patients            Patient[]
  auditLogs           AuditLog[]
  aiRequestLogs       AiRequestLog[]
  clinicalNotes       ClinicalNote[]
  organizationMembers OrganizationMember[]
  invitations         Invitation[]
  appointments        Appointment[]
  comments            Comment[]
  apiKeys             ApiKey[]
  assistantConversations AssistantConversation[]

  // =========================
  // SAAS Billing
  // =========================
  stripeCustomerId             String?
  stripeSubscriptionId         String?
  stripeSubscriptionStatus     String?
  stripeSubscriptionPlan       String?
  subscriptionCurrentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionPlan SubscriptionPlan @default(FREE)

  memberLimit Int @default(2)

  storageLimitMb Int @default(1024)

  apiLimitPerMonth Int @default(10000)

  patientLimit Int @default(50)

  aiRequestLimitPerMonth Int @default(20)

  onboardingCompleted Boolean    @default(false)
  onboardingStep      Int        @default(1)
  clinicSize          ClinicSize?
}

model Payment {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  stripePaymentIntentId String       @unique
  amount                Int
  currency              String
  status                String
  platformFee           Int
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([organizationId])
}

model File {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])
  patientId      String?
  patient        Patient?     @relation(fields: [patientId], references: [id])
  originalName   String
  mimeType       String
  size           Int
  storageKey     String       @unique
  publicUrl      String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([uploadedById])
  @@index([patientId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

model AuditLog {
  id             String        @id @default(uuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  action         String
  resource       String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model AiRequestLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  patientId      String?
  patient        Patient?     @relation(fields: [patientId], references: [id])
  noteId         String?
  prompt         String
  response       String
  tokens         Int
  model          String       @default("")
  cost           Float        @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([patientId])
  @@index([createdAt])
}

model ClinicalNote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  title          String?
  body           String
  aiSummary      String?
  keyPoints      Json?
  visitSummary   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([patientId, createdAt])
  @@index([organizationId])
}

model Patient {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])

  firstName   String
  lastName    String
  email       String?
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  address     String?
  notes       String?

  files         File[]
  clinicalNotes ClinicalNote[]
  aiRequestLogs AiRequestLog[]
  appointments  Appointment[]
  comments      Comment[]
  assistantConversations AssistantConversation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Uniqueness for (organizationId, email) is enforced by a Postgres partial
  // unique index that ignores soft-deleted rows. The index is created by hand
  // in the migration because Prisma cannot express partial conditions.
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, lastName, firstName])
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id])
  providerId     String?
  provider       User?             @relation("AppointmentProvider", fields: [providerId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  title          String?
  reason         String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  comments       Comment[]

  @@index([organizationId, startsAt])
  @@index([patientId])
  @@index([providerId, startsAt])
}

model Comment {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  patientId      String?
  patient        Patient?      @relation(fields: [patientId], references: [id])
  appointmentId  String?
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  body           String
  createdAt      DateTime      @default(now())

  @@index([patientId, createdAt])
  @@index([appointmentId, createdAt])
  @@index([organizationId])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  role           Role         @default(DOCTOR)
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId, status])
}

model ApiKey {
  id             String       @id @default(uuid())
  key            String       @unique
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revoked        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Role {
  PATIENT
  CLINIC_OWNER
  SUPER_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
}

enum MemberStatus {
  PENDING
  ACTIVE
  DISABLED
}

model Invitation {
  id             String           @id @default(uuid())
  email          String
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  role           Role
  token          String           @unique
  invitedByUserId String
  invitedBy      User             @relation("InvitationInviter", fields: [invitedByUserId], references: [id])
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?

  @@index([organizationId, status])
  @@index([email, organizationId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ClinicSize {
  SIZE_1_5
  SIZE_6_20
  SIZE_21_100
  SIZE_100_PLUS
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

model AssistantConversation {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       AssistantMessage[]

  @@index([patientId, updatedAt])
}

model AssistantMessage {
  id             String   @id @default(uuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AssistantMessageRole
  content        String
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}
